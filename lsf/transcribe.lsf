#!/bin/bash
# audio2md — Transcription LSF Batch Script
#BSUB -J audio2md-transcribe
#BSUB -oo %J.transcribe.out
#BSUB -eo %J.transcribe.err

set -euo pipefail

WORKDIR="$HOME/dev/audio2md"
cd "$WORKDIR"

# Load cluster modules if needed (edit for your cluster)
# source /etc/profile.d/modules.sh 2>/dev/null || true
# module load CUDA/12.4.0 2>/dev/null || true

echo "=== Transcription Job ===" >&2
echo "Node: $(hostname)" >&2
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null >&2
echo "Input: INPUTFILE" >&2
echo "Model: WHISPERMODEL" >&2

eval "$(conda shell.bash hook)"
conda activate audio2md

python3 "$WORKDIR/src/transcribe.py" \
    --input "INPUTFILE" \
    --model "WHISPERMODEL" \
    --output transcript.md

echo "=== Done ===" >&2
ls -lh transcript.md >&2
