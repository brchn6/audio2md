#!/bin/bash
# audio2md — Summarization LSF Batch Script
#BSUB -J audio2md-summarize
#BSUB -oo %J.summarize.out
#BSUB -eo %J.summarize.err

set -euo pipefail

WORKDIR=/home/labs/pilpel/barc/dev/audio2md
cd $WORKDIR

source /etc/profile.d/modules.sh 2>/dev/null || true
module load CUDA/12.4.0 2>/dev/null || true

echo "=== Summarization Job ===" >&2
echo "Node: $(hostname)" >&2
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null >&2
echo "Model: LLMMODEL" >&2

eval "$(conda shell.bash hook)"
conda activate audio2md

python3 /home/labs/pilpel/barc/dev/audio2md/src/summarize.py \
    --model "LLMMODEL" \
    --input transcript.md \
    --output english-summary.md

echo "=== Done ===" >&2
ls -lh english-summary.md >&2
